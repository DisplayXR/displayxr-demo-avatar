<?xml version="1.0" encoding="utf-8"?>
<!--
    Copyright 2026, The DisplayXR Project and its contributors
    SPDX-License-Identifier: Apache-2.0

    Android leg of displayxr-demo-avatar. A vendor-neutral OpenXR client:
    no CNSDK classes, no vendor .so — it binds to whatever DisplayXR runtime is
    installed via the Khronos OpenXR loader broker.

    ARCHITECTURE A (in-process, ADR-036 D2, runtime#1063): this app owns its
    own window and hands it to the runtime via XR_DXR_android_surface_binding;
    the runtime's native Vulkan compositor + the vendor display processor run
    IN THIS PROCESS and weave straight into our Surface. There is no
    runtime-spawned SurfaceView and no service overlay.

    Transparency: Theme.Avatar.Transparent + a TRANSLUCENT surface format make
    OUR OWN window translucent, and the session opts in formally with
    transparentBackgroundEnabled (#1082). The live launcher shows through around
    the tiger — with no alpha clamp, which the old service-overlay path imposed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 12+ package-visibility: cross-package intent/provider queries
        return empty unless declared here. Without this the Khronos loader's
        broker lookup returns a null cursor → xrCreateInstance fails
        XR_ERROR_RUNTIME_UNAVAILABLE (black screen). (runtime#510, NP02J.)
    -->
    <queries>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <provider
            android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"
            tools:replace="android:authorities" />
        <package android:name="org.freedesktop.monado.openxr_runtime.out_of_process" />
        <package android:name="org.freedesktop.monado.openxr_runtime.in_process" />
        <intent>
            <action android:name="org.freedesktop.monado.ipc.CONNECT" />
        </intent>

        <!--
            ARCHITECTURE A (in-process, ADR-036 D2) requirement — runtime#1079.
            In-process the vendor display processor runs in THIS process, and its
            core loader calls PackageManager.getPackageInfo() on the on-device
            vendor services to bind them for display config + face tracking.
            Package visibility is enforced per CALLING UID, so declaring them in
            the runtime APK is not enough: without these two lines the loader
            gets a NameNotFoundException it never clears and the next JNI call
            trips CheckJNI, aborting the app inside xrCreateSession.

            This is the LAST vendor-specific thing in a DisplayXR client APK —
            this APK still carries zero com.leia.* classes and zero vendor .so.
            They go away entirely once the vendor services advertise a neutral
            intent action (ADR-036 D5, org.displayxr.action.VENDOR_DISPLAY_SERVICE):
            an <intent> query on that action grants the same visibility with no
            vendor package name in any client manifest.
        -->
        <package android:name="com.leialoft.display.config" />
        <package android:name="com.leia.headtrackingservice" />
    </queries>

    <uses-feature
        android:glEsVersion="0x00030002"
        android:required="false" />

    <!--
        Architecture A: the vendor face tracker runs IN THIS PROCESS (it used to
        live in the out-of-process runtime service), so the front-camera grant is
        ours to hold. Without it the camera open silently fails, CNSDK never
        reports a face, and every xrLocateViews falls back to the nominal viewer
        — head tracking is simply absent, with no error. required="false" so the
        same APK still installs on hardware with no front camera.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Long XR sessions generate no input events; without WAKE_LOCK the screen
         dims and the session pauses. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        CLICK-THROUGH OVERLAY MODE (runtime#1110).

        Leo floats over the live desktop, so the desktop under him has to stay
        usable. Measured on stock Android 13: click-through needs a window that is
        (a) TIGHT — untrusted-touch occlusion is evaluated at the touch point
        against the FRAMES above it, so a window that does not contain the tap
        contributes nothing; (b) TOUCHABLE — inside its own frame the overlay is
        the *touched* window, so the opacity policy is never consulted and alpha
        stays 1.00 (a FLAG_NOT_TOUCHABLE application overlay is clamped by the
        platform to 0.80, which is where the old ghost came from); and (c) backed
        by NO Activity of ours in the foreground task, because an Activity parks a
        display-wide ActivityRecordInputSink that eats the fall-through.

        That means SYSTEM_ALERT_WINDOW for the window itself and a foreground
        service, since the Activity has to leave the foreground task. Neither is a
        platform grant or an OEM change. Without the (user-granted) SAW access the
        app falls back to the previous full-screen Activity topology: it still
        renders and weaves, it just swallows taps.

        NOTE (grant hygiene): SYSTEM_ALERT_WINDOW is reset on every reinstall.
        runtime#1072 re-grants it from build-android.sh; by hand it is
        `adb shell appops set com.displayxr.avatar_vk_android SYSTEM_ALERT_WINDOW allow`.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="DisplayXR Avatar">

        <!--
            ADR-036 D6 / runtime#1033: the app samples this window's on-screen
            origin (View.getLocationOnScreen) every frame and feeds it to the
            runtime so the weave's interlace phase is anchored where the window
            physically sits on the panel. An OEM that applies the
            OVERRIDE_SANDBOX_VIEW_BOUNDS_APIS compat change makes that call
            return WINDOW-relative coordinates — every window would report (0,0)
            and weave at the same (wrong) phase, with no error anywhere. Opting
            out is per-APP, so it has to live here.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_SANDBOXING_VIEW_BOUNDS_APIS"
            android:value="false" />

        <!--
            configChanges keeps the NativeActivity (and its Surface) alive across
            rotation + freeform resize instead of recreating it; resizeableActivity
            is what lets the task enter a freeform container at all.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Avatar.Transparent"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density|uiMode|navigation|keyboard|layoutDirection"
            android:resizeableActivity="true"
            android:launchMode="singleTask">
            <meta-data
                android:name="android.app.lib_name"
                android:value="avatar_vk_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Keep-alive only (runtime#1110) — it owns no window. In overlay mode the
            Activity deliberately leaves the foreground task, and without a
            foreground service the process becomes killable AND the in-process
            vendor face tracker's camera open becomes a *background* camera access,
            which fails silently (no face, no error). foregroundServiceType=camera
            is the honest type: in Architecture A the tracker really does open the
            front camera in this process.
        -->
        <service
            android:name=".AvatarOverlayService"
            android:exported="false"
            android:foregroundServiceType="camera" />

    </application>
</manifest>
